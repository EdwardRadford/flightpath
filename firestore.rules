rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper functions
    // -------------------------------------------------------------------------

    /// Returns true when the caller is signed in.
    function isAuthenticated() {
      return request.auth != null;
    }

    /// Returns true when the caller's UID matches the given uid.
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    /// Returns true when the caller is a participant of a conversation document.
    /// Uses participant_ids (the field name written by the Flutter client).
    function isParticipant(conversationData) {
      return isAuthenticated()
          && request.auth.uid in conversationData.participant_ids;
    }

    /// Returns true when the incoming write does NOT change any premium-status
    /// fields. These fields must only be written by Cloud Functions (webhook,
    /// purchase validation) — never by the client directly.
    function doesNotWritePremiumFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['has_purchased', 'subscription_status', 'granted_access', 'purchase_date']);
    }

    // -------------------------------------------------------------------------
    // users/{uid}
    // -------------------------------------------------------------------------
    match /users/{uid} {
      allow read: if isOwner(uid);

      // Owners may create their own document freely (first-time onboarding).
      allow create: if isOwner(uid);

      // Owners may update their own document but CANNOT touch premium fields.
      // Those fields are managed exclusively by Cloud Functions / RevenueCat
      // webhook to prevent privilege escalation.
      allow update: if isOwner(uid) && doesNotWritePremiumFields();

      // Deleting the user document is allowed (account deletion flow).
      allow delete: if isOwner(uid);

      // -----------------------------------------------------------------------
      // users/{uid}/lessons/{lessonId}
      // -----------------------------------------------------------------------
      match /lessons/{lessonId} {
        allow read, write: if isOwner(uid);
      }

      // -----------------------------------------------------------------------
      // users/{uid}/exercises/{exerciseId}
      // -----------------------------------------------------------------------
      match /exercises/{exerciseId} {
        allow read, write: if isOwner(uid);
      }

      // -----------------------------------------------------------------------
      // users/{uid}/goals/{goalId}
      // -----------------------------------------------------------------------
      match /goals/{goalId} {
        allow read, write: if isOwner(uid);
      }
    }

    // -------------------------------------------------------------------------
    // conversations/{conversationId}
    // -------------------------------------------------------------------------
    match /conversations/{conversationId} {
      allow read, write: if isParticipant(resource.data);

      // Allow a new conversation to be created when the caller is listed as a
      // participant in the document being written.
      allow create: if isAuthenticated()
          && request.auth.uid in request.resource.data.participant_ids;

      // -----------------------------------------------------------------------
      // conversations/{conversationId}/messages/{messageId}
      // -----------------------------------------------------------------------
      match /messages/{messageId} {
        // Re-fetch the parent conversation to verify participation. Firestore
        // does not surface parent data automatically inside sub-matches.
        allow read, write: if isAuthenticated()
            && request.auth.uid in
               get(/databases/$(database)/documents/conversations/$(conversationId)).data.participant_ids;
      }
    }

    // -------------------------------------------------------------------------
    // exercise_content/{exerciseId}  — read-only, no client writes ever
    // -------------------------------------------------------------------------
    match /exercise_content/{exerciseId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // quiz_questions/{docId}  — read-only, no client writes ever
    // -------------------------------------------------------------------------
    match /quiz_questions/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // flashcards/{docId}  — read-only, no client writes ever
    // -------------------------------------------------------------------------
    match /flashcards/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // share_links/{token}
    // -------------------------------------------------------------------------
    match /share_links/{token} {
      // Any authenticated user can read a share link (looked up by token).
      allow read: if isAuthenticated();

      // Only the owner (identified by the userId stored on the document) can
      // create, update, or delete their share links.
      allow create: if isAuthenticated()
          && request.auth.uid == request.resource.data.user_id;

      allow update, delete: if isAuthenticated()
          && request.auth.uid == resource.data.user_id;
    }

    // -------------------------------------------------------------------------
    // instructor_links — server-only via Admin SDK
    // -------------------------------------------------------------------------
    match /instructor_links/{doc} {
      allow read, write: if false; // Server-only via Admin SDK
    }

    // -------------------------------------------------------------------------
    // instructor_notes — server-only via Admin SDK
    // -------------------------------------------------------------------------
    match /instructor_notes/{doc} {
      allow read, write: if false; // Server-only via Admin SDK
    }

  }
}
