rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper functions
    // -------------------------------------------------------------------------

    /// Returns true when the caller is signed in.
    function isAuthenticated() {
      return request.auth != null;
    }

    /// Returns true when the caller's UID matches the given uid.
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    /// Returns true when the caller is a participant of a conversation document.
    /// Uses participant_ids (the field name written by the Flutter client).
    function isParticipant(conversationData) {
      return isAuthenticated()
          && request.auth.uid in conversationData.participant_ids;
    }

    /// Returns true when the incoming write does NOT change any premium-status
    /// fields. These fields must only be written by Cloud Functions (webhook,
    /// purchase validation) — never by the client directly.
    function doesNotWritePremiumFields() {
      return request.resource.data.has_purchased == resource.data.has_purchased
          && request.resource.data.subscription_status == resource.data.subscription_status
          && request.resource.data.granted_access == resource.data.granted_access
          && request.resource.data.get('purchase_date', null) == resource.data.get('purchase_date', null);
    }

    /// Returns true when the caller is an instructor linked to the given student.
    function isLinkedInstructor(studentUid) {
      let linkId = request.auth.uid + '_' + studentUid;
      return isAuthenticated()
          && exists(/databases/$(database)/documents/instructor_links/$(linkId));
    }

    // -------------------------------------------------------------------------
    // users/{uid}
    // -------------------------------------------------------------------------
    match /users/{uid} {
      // Any owner can read their own document.
      // An instructor linked to this student can also read their profile.
      allow read: if isOwner(uid) || isLinkedInstructor(uid);

      // Owners may create their own document freely (first-time onboarding).
      allow create: if isOwner(uid);

      // Owners may update their own document but CANNOT touch premium fields.
      // Those fields are managed exclusively by Cloud Functions / RevenueCat
      // webhook to prevent privilege escalation.
      allow update: if isOwner(uid) && doesNotWritePremiumFields();

      // Deleting the user document is allowed (account deletion flow).
      allow delete: if isOwner(uid);

      // -----------------------------------------------------------------------
      // users/{uid}/lessons/{lessonId}
      // -----------------------------------------------------------------------
      match /lessons/{lessonId} {
        allow read: if isOwner(uid) || isLinkedInstructor(uid);
        allow write: if isOwner(uid);
      }

      // -----------------------------------------------------------------------
      // users/{uid}/exercises/{exerciseId}
      // -----------------------------------------------------------------------
      match /exercises/{exerciseId} {
        allow read: if isOwner(uid) || isLinkedInstructor(uid);
        allow write: if isOwner(uid);
      }
    }

    // -------------------------------------------------------------------------
    // conversations/{conversationId}
    // -------------------------------------------------------------------------
    match /conversations/{conversationId} {
      allow read, write: if isParticipant(resource.data);

      // Allow a new conversation to be created when the caller is listed as a
      // participant in the document being written.
      allow create: if isAuthenticated()
          && request.auth.uid in request.resource.data.participant_ids;

      // -----------------------------------------------------------------------
      // conversations/{conversationId}/messages/{messageId}
      // -----------------------------------------------------------------------
      match /messages/{messageId} {
        // Re-fetch the parent conversation to verify participation. Firestore
        // does not surface parent data automatically inside sub-matches.
        allow read, write: if isAuthenticated()
            && request.auth.uid in
               get(/databases/$(database)/documents/conversations/$(conversationId)).data.participant_ids;
      }
    }

    // -------------------------------------------------------------------------
    // exercise_content/{exerciseId}  — read-only, no client writes ever
    // -------------------------------------------------------------------------
    match /exercise_content/{exerciseId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // quiz_questions/{docId}  — read-only, no client writes ever
    // -------------------------------------------------------------------------
    match /quiz_questions/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // share_links/{token}
    // -------------------------------------------------------------------------
    match /share_links/{token} {
      // Any authenticated user can read a share link (looked up by token).
      allow read: if isAuthenticated();

      // Only the owner (identified by the userId stored on the document) can
      // create, update, or delete their share links.
      allow create: if isAuthenticated()
          && request.auth.uid == request.resource.data.user_id;

      allow update, delete: if isAuthenticated()
          && request.auth.uid == resource.data.user_id;
    }

    // -------------------------------------------------------------------------
    // instructor_links/{inviteCode}
    // -------------------------------------------------------------------------
    match /instructor_links/{linkId} {
      // Any authenticated user can read links they are part of.
      allow read: if isAuthenticated();

      // Either the student or the instructor can create the link.
      allow create: if isAuthenticated()
          && (request.auth.uid == request.resource.data.instructor_id
              || request.auth.uid == request.resource.data.student_id);

      allow update, delete: if isAuthenticated()
          && (request.auth.uid == resource.data.instructor_id
              || request.auth.uid == resource.data.student_id);
    }

    // -------------------------------------------------------------------------
    // invite_codes/{inviteCode}
    // Maps an instructor's 6-char invite code to their UID.
    // Any authenticated user can look up a code for the linking flow.
    // Only the instructor who owns the code can create or delete it.
    // -------------------------------------------------------------------------
    match /invite_codes/{inviteCode} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
          && request.auth.uid == request.resource.data.instructor_id;

      // Codes are immutable once created — delete and recreate to change.
      allow update: if false;

      allow delete: if isAuthenticated()
          && request.auth.uid == resource.data.instructor_id;
    }

    // -------------------------------------------------------------------------
    // exercise_assessments/{assessmentId}
    // Instructor exercise criteria assessments for students.
    // Doc ID format: {instructorId}_{studentId}_{exerciseId}
    // -------------------------------------------------------------------------
    match /exercise_assessments/{assessmentId} {
      // The instructor who created the assessment and the assessed student can read.
      allow read: if isAuthenticated()
          && (request.auth.uid == resource.data.instructor_id
              || request.auth.uid == resource.data.student_id);

      // Only the instructor can create assessments.
      allow create: if isAuthenticated()
          && request.auth.uid == request.resource.data.instructor_id;

      // Only the instructor can update or delete their assessments.
      allow update, delete: if isAuthenticated()
          && request.auth.uid == resource.data.instructor_id;
    }

    // -------------------------------------------------------------------------
    // instructor_notes/{noteId}
    // -------------------------------------------------------------------------
    match /instructor_notes/{noteId} {
      // The instructor who created the note and the referenced student can read.
      allow read: if isAuthenticated()
          && (request.auth.uid == resource.data.instructor_id
              || request.auth.uid == resource.data.student_id);

      // Only the instructor can create, update, or delete their notes.
      allow create: if isAuthenticated()
          && request.auth.uid == request.resource.data.instructor_id;

      allow update, delete: if isAuthenticated()
          && request.auth.uid == resource.data.instructor_id;
    }

  }
}
